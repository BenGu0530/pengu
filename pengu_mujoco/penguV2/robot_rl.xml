<?xml version="1.0" ?>
<!-- RL variant of penguV2: the crank-slider closed loop is replaced by DIRECT
     PRISMATIC actuation of the foot sliders (leg extension = linear actuator,
     matching how the real robot's XM430 "slide" servos are commanded). This
     removes the equality (loop-closure) constraints -> open kinematic chain,
     GPU-sim friendly, faster, more stable. The closed-loop model (robot.xml)
     is kept intact for physics fidelity / sim-to-real frequency studies.

     5 actuators: hip-L, hip-R (hinge), slider-L, slider-R (PRISMATIC, leg ext),
     torso (hinge). Slider force limit = XM430 stall 4.1 N*m / ~0.025 m crank
     radius ~= 164 N -> capped at 150 N. -->
<mujoco model="penguV2_rl">
  <compiler angle="radian" meshdir="assets" autolimits="true"/>
  <option timestep="0.001" integrator="implicitfast"/>
  <default>
    <default class="penguV2">
      <joint frictionloss="0.1" armature="0.005"/>
      <position kp="50" dampratio="1" forcerange="-4.1 4.1"/>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" group="2"/>
      </default>
      <default class="collision">
        <geom group="3" contype="0" conaffinity="0"/>
      </default>
      <!-- prismatic leg-extension actuator: linear-equivalent of the XM430 via
           the crank radius. kp high enough to support body weight at small error. -->
      <default class="slide_act">
        <position kp="4000" dampratio="1" forcerange="-150 150"/>
      </default>
    </default>
  </default>
